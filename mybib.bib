@article{Reid2008,
  author = {Reid, R. I. and Gray, A. D. and Landecker, T. L. and Willis, A. G.},
  title = {Correcting the polarization leakage phases and amplitudes throughout the primary beam of an interferometer},
  journal = {Radio Science},
  volume = {43},
  number = {2},
  pages = {},
  keywords = {interferometers, polarimeters, interferometric techniques, polarimetric techniques},
  doi = {https://doi.org/10.1029/2007RS003709},
  url = {https://agupubs.onlinelibrary.wiley.com/doi/abs/10.1029/2007RS003709},
  eprint = {https://agupubs.onlinelibrary.wiley.com/doi/pdf/10.1029/2007RS003709},
  abstract = {Polarimetric observations are affected by leakage of unpolarized light into the polarization channels, in a way that varies with the angular position of the source relative to the optical axis. The off-axis part of the leakage is often corrected by subtracting the product of the unpolarized map and a leakage map from each polarization image, but it is seldom realized that heterogeneities in the array shift the loci of the leaked radiation in a baseline-dependent fashion. We present here a method to measure and remove the wide-field polarization leakage of a heterogeneous array. The process also maps the complex voltage patterns of each antenna, which can be used to correct all Stokes parameters for imaging errors due to the primary beams.},
  year = {2008}
}

